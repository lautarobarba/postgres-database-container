#!/usr/bin/env bash
# Backup de bases de datos PostgreSQL a otro servidor (local / LAN) usando rsync sobre SSH.
# Ver BACKUPS.md para la configuración.

#========== CONFIG ==========
# Bases de datos a respaldar (separadas por espacio)
DATABASES="mi_proyecto_db otro_proyecto_db"

# Servidor de destino
SSH_DEST_HOST=192.168.0.1
SSH_DEST_PORT=22
SSH_DEST_USER=backup_user
SSH_DEST_PATH=/home/backup_user/backups/postgres

# Servicio definido en compose.yaml
SERVICE_NAME=postgres_db
#======== END CONFIG ========

set -o pipefail
export PATH=/usr/local/bin:/usr/bin:/bin:${PATH}

SCRIPT_PATH=$(realpath "$0")
WORKDIR=$(dirname "${SCRIPT_PATH}")
LOG_FILE=${WORKDIR}/backup.log
LOCAL_DIR=${WORKDIR}/backups
FECHA=$(date +%Y%m%d-%H%M)

log() {
    echo "[$(date)] $*" >>"${LOG_FILE}"
}

fail() {
    log "STATUS: ERROR - $*"
    log "STATUS: BACKUP INCOMPLETO"
    log "------------------------------------"
    exit 1
}

cd "${WORKDIR}" || exit 1
mkdir -p "${LOCAL_DIR}"
log "========== Comenzando script Backup (rsync) - POSTGRESQL =========="

ERRORES=0
for DB_NAME in ${DATABASES}; do
    FILE=${LOCAL_DIR}/${DB_NAME}-${FECHA}.sql.gz

    log ">> Volcando ${DB_NAME} a ${FILE}"
    docker compose exec -T "${SERVICE_NAME}" \
        pg_dump -U postgres --clean --if-exists "${DB_NAME}" \
        2>>"${LOG_FILE}" | gzip >"${FILE}"
    if [ $? -ne 0 ]; then
        log "STATUS: ERROR al volcar ${DB_NAME}"
        rm -f "${FILE}"
        ERRORES=$((ERRORES + 1))
        continue
    fi
    log "STATUS: OK"
done

# Usuarios (roles) y sus contraseñas: no están incluidos en los backups de cada base.
# Se excluye el superusuario postgres para no pisar su contraseña al restaurar.
GLOBALS_FILE=${LOCAL_DIR}/pg_globals-${FECHA}.sql.gz
log ">> Volcando usuarios (roles) a ${GLOBALS_FILE}"
docker compose exec -T "${SERVICE_NAME}" \
    pg_dumpall -U postgres --globals-only \
    2>>"${LOG_FILE}" | grep -v -E '^(CREATE|ALTER) ROLE postgres( |;)' | gzip >"${GLOBALS_FILE}"
if [ $? -ne 0 ]; then
    log "STATUS: ERROR al volcar los usuarios"
    rm -f "${GLOBALS_FILE}"
    ERRORES=$((ERRORES + 1))
else
    log "STATUS: OK"
fi

# Si no se generó ningún archivo no hay nada para copiar
ls "${LOCAL_DIR}"/*-"${FECHA}".sql.gz >/dev/null 2>&1 || fail "no se generó ningún backup"

log ">> Copiando backups a ${SSH_DEST_USER}@${SSH_DEST_HOST}:${SSH_DEST_PATH} (puerto ${SSH_DEST_PORT})"
rsync -az -e "ssh -p ${SSH_DEST_PORT} -o BatchMode=yes" \
    "${LOCAL_DIR}"/*-"${FECHA}".sql.gz \
    "${SSH_DEST_USER}@${SSH_DEST_HOST}:${SSH_DEST_PATH}/" 2>>"${LOG_FILE}" \
    || fail "rsync falló, los backups quedan en ${LOCAL_DIR}"
log "STATUS: OK"

log ">> Eliminando copias locales ${LOCAL_DIR}/*-${FECHA}.sql.gz"
rm -f "${LOCAL_DIR}"/*-"${FECHA}".sql.gz && log "STATUS: OK" || log "STATUS: ERROR"

if [ ${ERRORES} -ne 0 ]; then
    fail "${ERRORES} base(s) de datos no se pudieron respaldar"
fi
log "STATUS: BACKUP FINALIZADO CORRECTAMENTE"
log "------------------------------------"
exit 0
